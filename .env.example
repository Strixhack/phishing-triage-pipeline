# ─────────────────────────────────────────────
#  Phishing Triage Pipeline — Environment Config
# ─────────────────────────────────────────────
#  Copy this to .env and fill in real keys when
#  you're ready to go beyond mock stubs.
#  Set USE_MOCK_STUBS=true to run fully offline.
# ─────────────────────────────────────────────

USE_MOCK_STUBS=true

# VirusTotal (free tier: 4 req/min)
VT_API_KEY=YOUR_VT_KEY_HERE

# AbuseIPDB (free tier: 1000 req/day)
ABUSEIPDB_API_KEY=YOUR_ABUSEIPDB_KEY_HERE

# MISP (self-hosted or community)
MISP_URL=https://your-misp-instance.local
MISP_API_KEY=YOUR_MISP_KEY_HERE

# TheHive (self-hosted)
THEHIVE_URL=http://localhost:9001
THEHIVE_API_KEY=YOUR_THEHIVE_KEY_HERE

# NIS2 config
NIS2_ORG_NAME="Your Organisation Name"
